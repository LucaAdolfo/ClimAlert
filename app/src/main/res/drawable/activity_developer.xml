<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".DeveloperActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_developer"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/dev_mode_title"
            app:navigationIcon="@drawable/ic_arrow_back" /> <!-- Icona Indietro Aggiunta -->

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/statusText_developer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:gravity="center"
            android:text="Pronto per i test."/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/testButton_developer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_activity_button"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scrapeButton_developer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/scrape_button_text"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/testSingleButton_developer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/test_single_button_text"/>

    </LinearLayout>

</LinearLayout>
